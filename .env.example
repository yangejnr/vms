PORT=5100
FLASK_DEBUG=1
SECRET_KEY=change-this-local-secret

# Default admin account, created on first run when no users exist.
# Change these before any real deployment.
DEFAULT_ADMIN_SERVICE_NO=ADMIN
DEFAULT_ADMIN_PASSWORD=NCS-1234

# Set to 1 to expose the local Flask app through ngrok.
NCS_ENABLE_NGROK=0

# Required by ngrok for authenticated tunnels.
NGROK_AUTHTOKEN=

# Optional paid/static ngrok settings.
NGROK_DOMAIN=
NGROK_REGION=
